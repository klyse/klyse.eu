---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import SectionMarker from "../components/SectionMarker.astro";
import Tabs from "../components/Tabs.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import { about, skills, projects, links } from "../data/site";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Stats />

    <section id="about" class="section wrap">
      <div class="section-head">
        <SectionMarker number="01" label="About" />
        <h2 class="t-title">About me</h2>
      </div>
      <div class="about">
        <div class="about-text">
          <p class="about-lede">{about.lede}</p>
          <ol class="steps">
            {
              about.steps.map((step) => (
                <li>
                  {step.map((part) =>
                    typeof part === "string" ? part : <a class="pill" href={part.href} target="_blank" rel="noreferrer">{part.pill}</a>
                  )}
                </li>
              ))
            }
          </ol>
          <p class="about-outro">{about.outro}</p>
        </div>
        <Tabs tabs={skills} />
      </div>
    </section>

    <section id="projects" class="section wrap">
      <div class="section-head">
        <SectionMarker number="02" label="Projects" />
        <h2 class="t-title">Things I built</h2>
      </div>
      <ul class="projects">
        {
          projects.map((p, i) => (
            <li>
              <ProjectCard number={String(i + 1).padStart(2, "0")} {...p} />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact" class="section wrap">
      <div class="section-head">
        <SectionMarker number="03" label="Contact" />
        <h2 class="t-title">Let's talk</h2>
      </div>
      <p class="contact-text">
        I'm always up for a good conversation: questions, ideas, or just hello. The quickest way to reach me is LinkedIn.
      </p>
      <div class="contact-actions">
        <Button href={links.linkedin} meta="↗" external>LinkedIn</Button>
        <Button href={links.github} variant="quiet" meta="↗" external>GitHub</Button>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .about { display: grid; grid-template-columns: 7fr 5fr; gap: var(--step-18); align-items: start; }
  .about > :global(.tabs) { position: sticky; top: 112px; }
  .about-lede { margin: 0 0 var(--step-8); max-width: 26ch; font-family: var(--font-display); font-size: 32px; line-height: 1.15; font-weight: 700; letter-spacing: -0.02em; }
  .about-outro { margin: var(--step-8) 0 0; max-width: 58ch; color: var(--ink-muted); }

  /* Each move is one line, led by an arrow */
  .steps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--step-3); }
  .steps li { position: relative; max-width: 58ch; padding-left: var(--step-8); line-height: 32px; }
  .steps li::before { content: "→"; position: absolute; left: 0; color: var(--glow); font-weight: 600; }
  /* The one link in the prose sits on a little slab */
  .pill {
    display: inline-block; margin-right: 4px; padding: 0 var(--step-3); line-height: 28px; white-space: nowrap;
    background: var(--glow); color: var(--on-glow);
    border: 1px solid var(--slab); border-radius: var(--radius-pill); box-shadow: var(--shadow-slab-sm);
    font-weight: 600; text-decoration: none;
    transition: transform var(--motion-step), box-shadow var(--motion-step);
  }
  @media (hover: hover) { .pill:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-slab); } }
  .pill:active { transform: translate(3px, 3px); box-shadow: none; }
  .projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--step-8); margin: 0; padding: 0 6px 6px 0; list-style: none; }
  .contact-text { margin: 0; max-width: 52ch; color: var(--ink-muted); }
  .contact-actions { display: flex; flex-wrap: wrap; gap: var(--step-6); margin-top: var(--step-8); }
  @media (max-width: 960px) { .projects { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; gap: var(--step-12); } .about > :global(.tabs) { position: static; } }
  @media (max-width: 620px) { .about-lede { font-size: 26px; } }
  @media (max-width: 620px) { .projects { grid-template-columns: 1fr; } }
</style>
