---
// Switches between Night and Day. Starts from the system setting until the visitor picks one;
// the pick is stored and applied before first paint by the inline script in Base.astro.
---

<button class="theme-toggle" type="button" aria-label="Switch theme" data-theme-toggle hidden>
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const system = window.matchMedia("(prefers-color-scheme: light)");
  const current = () => root.dataset.theme ?? (system.matches ? "day" : "night");

  const sync = (button: HTMLButtonElement) => {
    const next = current() === "night" ? "day" : "night";
    button.setAttribute("aria-label", `Switch to ${next} theme`);
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
      m.content = getComputedStyle(root).getPropertyValue("--ground").trim();
    });
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    // Rendered hidden so it never shows as a dead button without JS.
    button.hidden = false;
    sync(button);
    button.addEventListener("click", () => {
      const next = current() === "night" ? "day" : "night";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      sync(button);
    });
    system.addEventListener("change", () => sync(button));
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; padding: 0; cursor: pointer;
    background: var(--ground-raised); color: var(--ink);
    border: 1px solid var(--slab); border-radius: var(--radius-pill); box-shadow: var(--shadow-slab-sm);
    transition: transform var(--motion-step), box-shadow var(--motion-step);
  }
  @media (hover: hover) { .theme-toggle:hover { transform: translate(-3px, -3px); box-shadow: var(--shadow-slab); } }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:active { transform: translate(3px, 3px); box-shadow: none; }
  .icon { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* Show the theme you'd switch to: the sun at night, the moon by day */
  .icon-moon { display: none; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="night"])) .icon-sun { display: none; }
    :global(:root:not([data-theme="night"])) .icon-moon { display: block; }
  }
  :global(:root[data-theme="day"]) .icon-sun { display: none; }
  :global(:root[data-theme="day"]) .icon-moon { display: block; }
</style>
