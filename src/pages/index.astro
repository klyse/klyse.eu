---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import SectionMarker from "../components/SectionMarker.astro";
import Tabs from "../components/Tabs.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import { about, skills, projects, links } from "../data/site";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Stats />

    <section id="about" class="section wrap">
      <div class="section-head">
        <SectionMarker number="01" label="About" />
        <h2 class="t-title">About me</h2>
      </div>
      <div class="about">
        <div class="about-text">
          <p class="about-lede t-lede">{about.lede}</p>
          <ol class="path">
            {
              about.path.map((s, i) => (
                <li class:list={["step", i === 0 && "step-now"]}>
                  <span class="step-node" aria-hidden="true" />
                  <span class="step-when t-meta">{s.when}</span>
                  <h3 class="step-where">
                    {s.href ? <a href={s.href} target={s.href.startsWith("http") ? "_blank" : undefined} rel={s.href.startsWith("http") ? "noreferrer" : undefined}>{s.where}</a> : s.where}
                  </h3>
                  <p class="step-what">{s.what}</p>
                </li>
              ))
            }
          </ol>
          <p class="about-outro">{about.outro}</p>
        </div>
        <Tabs tabs={skills} />
      </div>
    </section>

    <section id="projects" class="section wrap">
      <div class="section-head">
        <SectionMarker number="02" label="Projects" />
        <h2 class="t-title">Things I built</h2>
      </div>
      <ul class="projects">
        {
          projects.map((p, i) => (
            <li>
              <ProjectCard number={String(i + 1).padStart(2, "0")} {...p} />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact" class="section wrap">
      <div class="section-head">
        <SectionMarker number="03" label="Contact" />
        <h2 class="t-title">Let's talk</h2>
      </div>
      <p class="contact-text">
        I'm always up for a good conversation: questions, ideas, or just hello. The quickest way to reach me is LinkedIn.
      </p>
      <div class="contact-actions">
        <Button href={links.linkedin} meta="↗" external>LinkedIn</Button>
        <Button href={links.github} variant="quiet" meta="↗" external>GitHub</Button>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .about { display: grid; grid-template-columns: 7fr 5fr; gap: var(--step-18); align-items: start; }
  .about > :global(.tabs) { position: sticky; top: 112px; }
  .about-lede { margin: 0 0 var(--step-8); max-width: 30ch; font-family: var(--font-display); font-size: 32px; line-height: 1.15; font-weight: 700; letter-spacing: -0.02em; }
  .about-outro { margin: var(--step-8) 0 0; max-width: 52ch; color: var(--ink-muted); }

  /* Career path: a rail of round nodes, the current stop glowing */
  .path { position: relative; margin: 0; padding: 0; list-style: none; }
  .path::before { content: ""; position: absolute; left: 11px; top: 14px; bottom: 14px; width: 2px; background: repeating-linear-gradient(var(--line-strong) 0 6px, transparent 6px 12px); }
  .step { position: relative; display: grid; grid-template-columns: 24px 1fr; column-gap: var(--step-6); padding: var(--step-3) 0 var(--step-6); }
  .step-node {
    position: relative; grid-row: 1 / span 3; width: 24px; height: 24px; margin-top: 2px;
    background: var(--ground-raised); border: 1px solid var(--slab); border-radius: var(--radius-pill);
    box-shadow: var(--shadow-slab-sm);
    transition: transform var(--motion-step), box-shadow var(--motion-step), background var(--motion-step);
  }
  .step-now .step-node { background: var(--glow); }
  .step-now .step-node::after { content: ""; position: absolute; inset: -1px; border-radius: inherit; border: 2px solid var(--glow); animation: ping 2.4s ease-out infinite; }
  @media (hover: hover) {
    .step:hover .step-node { transform: translate(-2px, -2px); box-shadow: var(--shadow-slab); }
    .step:not(.step-now):hover .step-node { background: var(--sun); }
  }
  .step-when { color: var(--ink-muted); text-transform: uppercase; }
  .step-now .step-when { color: var(--glow); }
  .step-where { margin: var(--step-1) 0 0; font: 700 24px/1.15 var(--font-display); letter-spacing: -0.02em; }
  .step-where a { color: inherit; text-decoration: none; background: linear-gradient(var(--glow), var(--glow)) 0 100% / 0 2px no-repeat; transition: background-size var(--motion-climb); }
  .step-where a:hover { background-size: 100% 2px; }
  .step-what { margin: var(--step-1) 0 0; max-width: 52ch; color: var(--ink-muted); }
  @keyframes ping { 0% { transform: scale(1); opacity: .8; } 80%, 100% { transform: scale(2.2); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .step-now .step-node::after { animation: none; } }
  .projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--step-8); margin: 0; padding: 0 6px 6px 0; list-style: none; }
  .contact-text { margin: 0; max-width: 52ch; color: var(--ink-muted); }
  .contact-actions { display: flex; flex-wrap: wrap; gap: var(--step-6); margin-top: var(--step-8); }
  @media (max-width: 960px) { .projects { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; gap: var(--step-12); } .about > :global(.tabs) { position: static; } }
  @media (max-width: 620px) { .about-lede { font-size: 26px; } .step-where { font-size: 21px; } }
  @media (max-width: 620px) { .projects { grid-template-columns: 1fr; } }
</style>
