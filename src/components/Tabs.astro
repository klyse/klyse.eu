---
interface Props {
  tabs: { id: string; title: string; items: string[] }[];
}

const { tabs } = Astro.props;
---

<div class="tabs" data-tabs>
  <p class="tabs-title t-meta">Toolbox</p>
  <div class="tabs-list" role="tablist" aria-label="Toolbox">
    {
      tabs.map((t, i) => (
        <button class="tab" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          <span class="tab-no">{String(i + 1).padStart(2, "0")}</span>
          {t.title}
        </button>
      ))
    }
  </div>
  {
    tabs.map((t, i) => (
      <ul class="tabs-panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
        {t.items.map((x, j) => <li style={`--i: ${j}`}>{x}</li>)}
      </ul>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const target: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(e.key in target)) return;
        e.preventDefault();
        const next = tabs[target[e.key]];
        select(next);
        next.focus();
      });
    });
  }
</script>

<style>
  .tabs {
    padding: var(--step-6); background: var(--ground-raised);
    border: 1px solid var(--slab); border-radius: var(--radius-lg); box-shadow: var(--shadow-slab);
  }
  .tabs-title { margin: 0 0 var(--step-4); color: var(--ink-muted); text-transform: uppercase; }
  .tabs-list { display: flex; gap: var(--step-1); padding: var(--step-1); background: var(--ground-sunken); border-radius: var(--radius-pill); }
  .tab {
    flex: 1; display: flex; justify-content: center; gap: var(--step-2); align-items: baseline;
    padding: var(--step-2) var(--step-3);
    background: none; border: 1px solid transparent; border-radius: var(--radius-pill); cursor: pointer;
    font: 600 15px/20px var(--font-sans); color: var(--ink-muted);
    transition: color var(--motion-step), background var(--motion-step), box-shadow var(--motion-step);
  }
  .tab:hover { color: var(--ink); }
  .tab[aria-selected="true"] { color: var(--on-glow); background: var(--glow); border-color: var(--slab); box-shadow: var(--shadow-slab-sm); }
  .tab-no { font: 400 12px/16px var(--font-mono); opacity: .7; }
  .tabs-panel { list-style: none; margin: 0; padding: var(--step-6) 0 0; display: flex; flex-wrap: wrap; gap: var(--step-3); }
  .tabs-panel[hidden] { display: none; }
  .tabs-panel li {
    padding: var(--step-2) var(--step-4);
    background: var(--ground); border: 1px solid var(--slab); border-radius: var(--radius-pill); box-shadow: var(--shadow-slab-sm);
    font: 500 15px/20px var(--font-sans);
    animation: pop var(--motion-climb) cubic-bezier(.3, 1.5, .5, 1) both; animation-delay: calc(var(--i) * 40ms);
    transition: transform var(--motion-step), box-shadow var(--motion-step);
  }
  @media (hover: hover) { .tabs-panel li:hover { transform: translate(-3px, -3px); box-shadow: var(--shadow-slab); } }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.9); } }
  @media (prefers-reduced-motion: reduce) { .tabs-panel li { animation: none; } }
  @media (max-width: 420px) { .tab-no { display: none; } }
</style>
