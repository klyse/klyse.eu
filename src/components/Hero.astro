---
import Button from "./Button.astro";
import Portrait from "./Portrait.astro";
import { hero, links } from "../data/site";
---

<section class="hero wrap">
  <div class="hero-text">
    <p class="t-meta hero-kicker">Klaus Prünster · Software Architect</p>
    <h1 class="t-hero">klaus<span class="dot"><span>.</span></span></h1>
    <p class="t-lede hero-lede">{hero.lede}</p>
    <div class="hero-actions">
      <Button href="#contact">Get in touch</Button>
      <Button href={links.durst} variant="quiet" meta="↗" external>Work: Durst Group</Button>
    </div>
  </div>
  <div class="hero-photo">
    <Portrait size={380} />
  </div>
</section>

<script>
  // A click sends the full stop hopping off its slab; the class is cleared so it can hop again.
  for (const dot of document.querySelectorAll<HTMLElement>(".hero .dot")) {
    dot.addEventListener("click", () => {
      dot.classList.remove("hop");
      void dot.offsetWidth;
      dot.classList.add("hop");
    });
    dot.addEventListener("animationend", () => dot.classList.remove("hop"));
  }
</script>

<style>
  .hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--step-12); align-items: center; padding-top: var(--step-18); padding-bottom: var(--step-12); }
  .hero-kicker { margin: 0 0 var(--step-6); color: var(--ink-muted); }
  h1 { margin: 0; }
  /* The outer span is a still hit area so the pointer can't slip off mid-lift; only the inner one moves.
     The slab stays put: whatever the dot moves, its shadow offset moves back. */
  .dot { display: inline-block; cursor: pointer; user-select: none; }
  .dot > span { display: inline-block; transition: transform var(--motion-step), text-shadow var(--motion-step); }
  @media (hover: hover) { .dot:hover > span { transform: translate(-4px, -4px); text-shadow: 9px 9px 0 var(--slab); } }
  .dot:active > span { transform: translate(5px, 5px); text-shadow: 0 0 0 var(--slab); }
  .dot.hop > span { animation: hop var(--motion-climb) cubic-bezier(.3, 0, .4, 1); }
  @keyframes hop {
    0%, 100% { transform: none; text-shadow: 5px 5px 0 var(--slab); }
    45% { transform: translateY(-0.35em); text-shadow: 5px calc(5px + 0.35em) 0 var(--slab); }
    80% { transform: translate(3px, 3px); text-shadow: 2px 2px 0 var(--slab); }
  }
  @media (prefers-reduced-motion: reduce) { .dot.hop > span { animation: none; } }
  .hero-lede { margin: var(--step-8) 0 0; max-width: 34ch; color: var(--ink-muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--step-6); margin-top: var(--step-12); }
  .hero-photo { justify-self: end; padding: 0 12px 12px 0; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: var(--step-8); padding-top: var(--step-8); }
    .hero-photo { justify-self: start; grid-row: 1; }
    .hero-photo :global(.portrait) { width: 168px; --lift: 3px; --slab-rest: 6px; }
    .hero-kicker { margin-bottom: var(--step-3); }
    .hero-lede { margin-top: var(--step-6); }
    .hero-actions { margin-top: var(--step-8); gap: var(--step-4); }
  }
</style>
