---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import SectionMarker from "../components/SectionMarker.astro";
import Tabs from "../components/Tabs.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import { about, skills, projects, links } from "../data/site";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Stats />

    <section id="about" class="section wrap">
      <div class="section-head">
        <SectionMarker number="01" label="About" />
        <h2 class="t-title">About me</h2>
      </div>
      <div class="about">
        <div class="about-text">
          <p class="about-lede">{about.lede}</p>
          {
            about.story.map((para) => (
              <p class="story">
                {para.map((part) =>
                  typeof part === "string" ? (
                    part
                  ) : part.href ? (
                    <a class="pill" href={part.href} target={part.href.startsWith("http") ? "_blank" : undefined} rel={part.href.startsWith("http") ? "noreferrer" : undefined}>{part.pill}</a>
                  ) : (
                    <span class="pill">{part.pill}</span>
                  )
                )}
              </p>
            ))
          }
          <ul class="likes">
            {about.likes.map((l) => <li>{l}</li>)}
          </ul>
          <p class="likes-tail">…in code and out of it.</p>
        </div>
        <Tabs tabs={skills} />
      </div>
    </section>

    <section id="projects" class="section wrap">
      <div class="section-head">
        <SectionMarker number="02" label="Projects" />
        <h2 class="t-title">Things I built</h2>
      </div>
      <ul class="projects">
        {
          projects.map((p, i) => (
            <li>
              <ProjectCard number={String(i + 1).padStart(2, "0")} {...p} />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact" class="section wrap">
      <div class="section-head">
        <SectionMarker number="03" label="Contact" />
        <h2 class="t-title">Let's talk</h2>
      </div>
      <p class="contact-text">
        I'm always up for a good conversation: questions, ideas, or just hello. The quickest way to reach me is LinkedIn.
      </p>
      <div class="contact-actions">
        <Button href={links.linkedin} meta="↗" external>LinkedIn</Button>
        <Button href={links.github} variant="quiet" meta="↗" external>GitHub</Button>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .about { display: grid; grid-template-columns: 7fr 5fr; gap: var(--step-18); align-items: start; }
  .about > :global(.tabs) { position: sticky; top: 112px; }
  .about-lede { margin: 0 0 var(--step-8); max-width: 26ch; font-family: var(--font-display); font-size: 32px; line-height: 1.15; font-weight: 700; letter-spacing: -0.02em; }
  .story { margin: 0 0 var(--step-6); max-width: 58ch; font-size: 19px; line-height: 40px; }

  /* Key words sit on little slabs inside the prose */
  .pill {
    display: inline-block; padding: 0 var(--step-3); margin: 0 2px;
    line-height: 30px; white-space: nowrap;
    background: var(--ground-raised); color: var(--ink);
    border: 1px solid var(--slab); border-radius: var(--radius-pill); box-shadow: var(--shadow-slab-sm);
    font-weight: 600; text-decoration: none;
    transition: transform var(--motion-step), box-shadow var(--motion-step), background var(--motion-step);
  }
  a.pill { background: var(--glow); color: var(--on-glow); }
  @media (hover: hover) { .pill:hover { transform: translate(-2px, -2px) rotate(-2deg); box-shadow: var(--shadow-slab); } }
  a.pill:active { transform: translate(3px, 3px); box-shadow: none; }

  /* Round stickers, slapped on slightly crooked */
  .likes { display: flex; flex-wrap: wrap; margin: var(--step-12) 0 0; padding: 0; list-style: none; }
  .likes li {
    display: grid; place-items: center; width: clamp(104px, 28vw, 136px); aspect-ratio: 1; margin-right: -10px; padding: var(--step-4);
    border: 1px solid var(--slab); border-radius: var(--radius-pill); box-shadow: var(--shadow-slab-sm);
    color: var(--on-glow); text-align: center; font: 700 15px/1.15 var(--font-display);
    transition: transform var(--motion-climb) cubic-bezier(.3, 1.5, .5, 1), box-shadow var(--motion-step);
  }
  .likes li:nth-child(1) { background: var(--glow); transform: rotate(-8deg); }
  .likes li:nth-child(2) { background: var(--pine); transform: rotate(5deg) translateY(10px); }
  .likes li:nth-child(3) { background: var(--sun); transform: rotate(-3deg); }
  @media (hover: hover) { .likes li:hover { transform: rotate(0) scale(1.08); box-shadow: var(--shadow-slab); z-index: 1; } }
  .likes-tail { margin: var(--step-6) 0 0; font: 400 12px/16px var(--font-mono); letter-spacing: .04em; color: var(--ink-muted); }
  .projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--step-8); margin: 0; padding: 0 6px 6px 0; list-style: none; }
  .contact-text { margin: 0; max-width: 52ch; color: var(--ink-muted); }
  .contact-actions { display: flex; flex-wrap: wrap; gap: var(--step-6); margin-top: var(--step-8); }
  @media (max-width: 960px) { .projects { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; gap: var(--step-12); } .about > :global(.tabs) { position: static; } }
  @media (max-width: 620px) { .about-lede { font-size: 26px; } .story { font-size: 17px; line-height: 38px; } }
  @media (max-width: 620px) { .projects { grid-template-columns: 1fr; } }
</style>
