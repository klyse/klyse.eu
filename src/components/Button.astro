---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "quiet";
  meta?: string;
  external?: boolean;
}

const { href, variant = "primary", meta, external = false } = Astro.props;
---

<a class:list={["btn", `btn-${variant}`]} href={href} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
  <span><slot /></span>
  {meta && <span class="btn-meta">{meta}</span>}
</a>

<style>
  .btn {
    display: inline-flex; align-items: center; gap: var(--step-3);
    padding: var(--step-3) var(--step-6);
    border: 1px solid var(--slab); border-radius: var(--radius-pill);
    box-shadow: var(--shadow-slab-sm);
    font: 600 15px/20px var(--font-sans); text-decoration: none;
    transition: transform var(--motion-step), box-shadow var(--motion-step);
  }
  .btn:hover { transform: translate(-3px, -3px); box-shadow: var(--shadow-slab); }
  .btn:active { transform: translate(3px, 3px); box-shadow: none; }
  .btn-primary { background: var(--glow); color: var(--on-glow); }
  .btn-secondary { background: var(--ink); color: var(--ground); }
  .btn-quiet { background: var(--ground-raised); color: var(--ink); }
  .btn-meta { font: 400 12px/16px var(--font-mono); letter-spacing: .04em; opacity: .8; }
</style>
