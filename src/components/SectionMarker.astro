---
interface Props {
  number: string;
  label: string;
}

const { number, label } = Astro.props;
---

<div class="marker">
  <span class="marker-no">{number}</span>
  <span class="marker-label">{label}</span>
</div>

<style>
  .marker { display: inline-flex; align-items: center; gap: var(--step-4); }
  .marker-no {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 40px; height: 40px; padding: 0 var(--step-2);
    background: var(--ground-raised); border: 1px solid var(--slab);
    border-radius: var(--radius-md); box-shadow: var(--shadow-slab-sm);
    font: 500 13px/1 var(--font-mono); color: var(--ink);
  }
  .marker-label { font: 400 12px/16px var(--font-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-muted); }
</style>
