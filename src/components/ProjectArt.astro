---
// Project illustrations drawn from the UI's own shapes: pills, discs and keys on slabs.
// Colours come from the theme tokens; archived projects swap the accent for muted ink.
import type { ArtKind } from "../data/site";

interface Props {
  kind: ArtKind;
  archived?: boolean;
}

type Tone = "accent" | "raised" | "muted";
type Shape =
  | { t: "rect"; x: number; y: number; w: number; h: number; r: number; tone: Tone; slab?: boolean }
  | { t: "circle"; x: number; y: number; r: number; tone: Tone; slab?: boolean }
  | { t: "path"; d: string; tone: Tone; slab?: boolean };

const rect = (x: number, y: number, w: number, h: number, r: number, tone: Tone, slab = true): Shape => ({ t: "rect", x, y, w, h, r, tone, slab });
const disc = (x: number, y: number, r: number, tone: Tone, slab = true): Shape => ({ t: "circle", x, y, r, tone, slab });
const path = (d: string, tone: Tone, slab = true): Shape => ({ t: "path", d, tone, slab });

function keys(): Shape[] {
  const lit = new Set(["0-1", "1-4", "2-2", "2-5"]);
  const out: Shape[] = [];
  for (let row = 0; row < 3; row++)
    for (let col = 0; col < 7; col++) {
      const x = 42 + col * 32 + (row === 1 ? 8 : row === 2 ? 16 : 0);
      out.push(rect(x, 30 + row * 30, 24, 22, 6, lit.has(`${row}-${col}`) ? "accent" : "raised"));
    }
  return out;
}

function priceBars(): Shape[] {
  // weekly prices; the cheapest one is the deal
  const heights = [52, 64, 46, 72, 58, 28, 40];
  const low = heights.indexOf(Math.min(...heights));
  return heights.map((h, i) => rect(64 + i * 26, 116 - h, 16, h, 8, i === low ? "accent" : "raised"));
}

const scenes: Record<ArtKind, Shape[]> = {
  // two lenses and a bridge, with a signal going out
  xr: [rect(132, 60, 36, 18, 9, "raised"), disc(112, 70, 30, "accent"), disc(188, 70, 30, "accent"), disc(242, 44, 6, "muted"), disc(258, 34, 6, "muted"), disc(274, 24, 6, "muted")],
  // the Strawanzer cat in its sunglasses; whiskers and face are drawn below
  cat: [
    rect(118, 96, 64, 70, 30, "raised"),
    path("M120 52 Q114 18 124 15 Q131 13 146 30 Z", "raised"),
    path("M180 52 Q186 18 176 15 Q169 13 154 30 Z", "raised"),
    disc(150, 62, 36, "raised"),
    disc(134, 60, 13, "accent"),
    disc(166, 60, 13, "accent"),
  ],
  // a watch with straps; the ring is drawn separately below
  watch: [rect(128, -10, 44, 40, 12, "muted"), rect(128, 110, 44, 40, 12, "muted"), rect(112, 22, 76, 96, 26, "raised")],
  // three overlapping moods; their faces are drawn below
  emotions: [disc(110, 72, 30, "muted"), disc(150, 64, 30, "raised"), disc(190, 74, 30, "accent")],
  // a week of prices, the lowest one marked
  price: priceBars(),
  // a keyboard with a few keys lit
  keyboard: keys(),
};

const { kind, archived = false } = Astro.props;
const shapes = scenes[kind];
const O = 4; // slab offset in viewBox units
---

<div class:list={["art", archived && "art-archived"]} aria-hidden="true">
  <svg viewBox="0 0 300 140" preserveAspectRatio="xMidYMid slice">
    {
      shapes.map((s) =>
        s.t === "rect" ? (
          <g>
            {s.slab !== false && <rect class="slab" x={s.x + O} y={s.y + O} width={s.w} height={s.h} rx={s.r} />}
            <rect class:list={["face", s.tone]} x={s.x} y={s.y} width={s.w} height={s.h} rx={s.r} />
          </g>
        ) : s.t === "circle" ? (
          <g>
            {s.slab !== false && <circle class="slab" cx={s.x + O} cy={s.y + O} r={s.r} />}
            <circle class:list={["face", s.tone]} cx={s.x} cy={s.y} r={s.r} />
          </g>
        ) : (
          <g>
            {s.slab !== false && <path class="slab" d={s.d} transform={`translate(${O} ${O})`} />}
            <path class:list={["face", s.tone]} d={s.d} />
          </g>
        ),
      )
    }
    {
      kind === "emotions" && (
        <g class="icon">
          <circle class="icon-fill" cx="104" cy="68" r="2.6" />
          <circle class="icon-fill" cx="116" cy="68" r="2.6" />
          <path d="M102 76 Q110 84 118 76" />
          <circle class="icon-fill" cx="144" cy="59" r="2.6" />
          <circle class="icon-fill" cx="156" cy="59" r="2.6" />
          <circle cx="150" cy="70" r="4.5" />
          <path class="icon-fill" d="M190 83 C177 75 180 62 190 68 C200 62 203 75 190 83 Z" />
        </g>
      )
    }
    {
      kind === "cat" && (
        <g class="icon">
          <path d="M147 57 Q150 54 153 57" />
          <path class="glint" d="M128 64 L136 52 M133 67 L140 56 M160 64 L168 52 M165 67 L172 56" />
          <path class="icon-fill" d="M146 77 L154 77 L150 81 Z" />
          <path d="M150 81 Q147 86 143 84 M150 81 Q153 86 157 84" />
          <path class="whisker" d="M120 76 L96 72 M121 81 L98 86 M180 76 L204 72 M179 81 L202 86" />
        </g>
      )
    }
    {kind === "watch" && <circle class="ring" cx="150" cy="70" r="24" pathLength="100" stroke-dasharray="68 100" transform="rotate(-90 150 70)" />}
  </svg>
</div>

<style>
  .art { height: 140px; margin: calc(var(--step-6) * -1) calc(var(--step-6) * -1) var(--step-2); border-bottom: 1px solid var(--slab); border-radius: var(--radius-lg) var(--radius-lg) 0 0; background: var(--ground-sunken); overflow: hidden; }
  svg { display: block; width: 100%; height: 100%; }
  .slab { fill: var(--slab); }
  .face { stroke: var(--slab); stroke-width: 1.2; }
  .accent { fill: var(--glow); }
  .raised { fill: var(--ground-raised); }
  .muted { fill: var(--ink-muted); }
  .icon { fill: none; stroke: var(--slab); stroke-width: 2.6; stroke-linecap: round; }
  .icon .icon-fill { fill: var(--slab); stroke: none; }
  .icon .glint { stroke: var(--ground-raised); stroke-width: 2.4; }
  .icon .whisker { stroke-width: 1.6; }
  .ring { fill: none; stroke: var(--glow); stroke-width: 7; stroke-linecap: round; }
  .art-archived .accent { fill: var(--ink-muted); }
  .art-archived .ring { stroke: var(--ink-muted); }
</style>
