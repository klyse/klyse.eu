---
interface Props {
  tabs: { id: string; title: string; items: string[] }[];
}

const { tabs } = Astro.props;
---

<div class="tabs" data-tabs>
  <div class="tabs-list" role="tablist">
    {
      tabs.map((t, i) => (
        <button class="tab" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          <span class="tab-no">{String(i + 1).padStart(2, "0")}</span>
          {t.title}
        </button>
      ))
    }
  </div>
  {
    tabs.map((t, i) => (
      <ul class="tabs-panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
        {t.items.map((x) => <li>{x}</li>)}
      </ul>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const target: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(e.key in target)) return;
        e.preventDefault();
        const next = tabs[target[e.key]];
        select(next);
        next.focus();
      });
    });
  }
</script>

<style>
  .tabs-list { display: flex; flex-wrap: wrap; border-bottom: 1px solid var(--line); }
  .tab {
    display: flex; gap: var(--step-2); align-items: baseline;
    margin: 0 var(--step-6) -1px 0; padding: var(--step-3) 0;
    background: none; border: 0; border-bottom: 3px solid transparent; cursor: pointer;
    font: 600 15px/20px var(--font-sans); color: var(--ink-muted);
    transition: color var(--motion-step), border-color var(--motion-step);
  }
  .tab:hover { color: var(--ink); }
  .tab[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--glow); }
  .tab-no { font: 400 12px/16px var(--font-mono); color: var(--ink-muted); }
  .tab[aria-selected="true"] .tab-no { color: var(--glow); }
  .tabs-panel { list-style: none; margin: 0; padding: var(--step-6) 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0 var(--step-6); }
  .tabs-panel[hidden] { display: none; }
  .tabs-panel li { display: flex; align-items: center; gap: var(--step-3); padding: var(--step-2) 0; border-bottom: 1px solid var(--line); }
  .tabs-panel li::before { content: ""; width: 8px; height: 8px; border-radius: var(--radius-pill); background: var(--glow); flex: none; }
</style>
