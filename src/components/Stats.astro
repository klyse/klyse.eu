---
import { stats } from "../data/site";
---

<dl class="stats wrap">
  {
    stats.map((s) => (
      <div class="stat">
        <dt class="t-meta">{s.label}</dt>
        <dd class="t-stat">
          {s.prefix}
          {s.value}
          {s.suffix && <span class="suffix">{s.suffix}</span>}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: var(--step-12); margin-bottom: 0; }
  .stat { display: flex; flex-direction: column-reverse; gap: var(--step-2); padding: var(--step-6); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: 0; }
  dt { color: var(--ink-muted); text-transform: uppercase; }
  dd { margin: 0; }
  .suffix { color: var(--glow); }
  @media (max-width: 720px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .stat { padding-left: 0; }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(n + 3) { border-top: 0; }
  }
</style>
